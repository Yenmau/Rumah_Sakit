<IfModule mod_rewrite.c>
RewriteEngine On

# Route all /api/* requests to the Back-End API Front Controller
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# Normal 404 fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule !\.(css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|map)$ 404.php [L]
</IfModule>
